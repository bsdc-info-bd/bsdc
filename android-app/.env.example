# The site the shell wraps. Only ever an https origin owned by BSDC.
BSDC_SITE_URL=https://www.bsdc.info.bd

# Release signing. Supplied by CI from repository secrets; never committed.
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# The SHA-256 fingerprint of the release signing certificate, published at
# /.well-known/assetlinks.json so Android verifies the app links.
ANDROID_CERT_FINGERPRINT=
