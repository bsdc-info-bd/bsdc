{
  "name": "bsdc-main-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bangladesh Software Development Community - main community platform (www.bsdc.info.bd)",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "scripts": {
    "brand": "node scripts/generate-brand-assets.mjs",
    "prebuild": "npm run brand",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:functions": "tsc -p functions/tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "5.59.0",
    "clsx": "2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "3.6.0",
    "firebase": "^10.14.0",
    "framer-motion": "11.5.4",
    "i18next": "23.15.1",
    "lucide-react": "0.445.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.0.13",
    "react-helmet-async": "2.0.5",
    "react-hook-form": "^7.53.0",
    "react-i18next": "15.0.2",
    "react-router-dom": "6.26.2",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^22.7.4",
    "@types/react": "18.3.9",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.7.0",
    "@typescript-eslint/parser": "8.7.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.0",
    "eslint-plugin-react": "7.36.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.12",
    "jsdom": "25.0.1",
    "postcss": "8.4.47",
    "postcss-import": "^16.1.0",
    "prettier": "3.3.3",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "vite-plugin-pwa": "0.20.5",
    "vitest": "2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
