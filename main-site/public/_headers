/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.gstatic.com https://apis.google.com https://cdn.onesignal.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ibb.co https://*.ibb.co https://i.ibb.co.com https://*.ibb.co.com https://*.tile.openstreetmap.org https://*.googleusercontent.com https://avatars.githubusercontent.com https://*.yimg.com; font-src 'self' data:; frame-src 'self' https://www.bsdc.info.bd https://bsdc.info.bd https://bsdc-bd.firebaseapp.com https://bsdc-bd.web.app; connect-src 'self' https://www.bsdc.info.bd https://bsdc.info.bd https://*.supabase.co wss://*.supabase.co https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasedatabase.app wss://*.firebasedatabase.app https://bsdc-bd.firebaseapp.com https://bsdc-bd.web.app https://*.googleapis.com https://onesignal.com https://nominatim.openstreetmap.org; media-src 'self' https://i.ibb.co https://*.ibb.co https://i.ibb.co.com https://*.ibb.co.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache

# The manifest decides whether an install is possible at all — on iOS it is the
# difference between a home-screen web app that can be woken and a bookmark that
# cannot — so a wrong one must not sit in a cache for a week after the fix ships.
/manifest.webmanifest
  Cache-Control: no-cache

# The document names the chunks, and a chunk's name carries its content hash, so
# a document served from cache is a document asking for files that the next
# deployment has already deleted. Every entry point is revalidated — the
# prerenderer writes one HTML file per route, including `about/index.html`, and
# a rule for `/index.html` alone left `about/` and the rest of them cached.
# See src/lib/site/chunk-recovery.ts for what a visitor used to see when they
# were.
/index.html
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/*/
  Cache-Control: no-cache

# The font never changes name: a replacement ships under a new one, so a year
# is safe here and saves a revalidation on every repeat visit.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Deliberately no rule for /media/i.
#
# A `_headers` rule cannot be scoped by status: it declares one caching policy
# for a path, and the 7-day `immutable` that used to be declared here was meant
# for the verified image bytes. On any deployment that also applies `_headers`
# to Function responses, that policy then covered the 502s and 504s the endpoint
# returns when ImgBB is briefly unreachable — one bad minute remembered as the
# picture, for a week, until the member cleared their cache. The endpoint sets
# its own headers instead: immutable for verified bytes, `no-store` for
# everything else. See functions/media/i.ts.

# Never cached: every one of these answers depends on who is asking.
/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
