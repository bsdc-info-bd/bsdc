# ---------------------------------------------------------------------------
# BSDC main-site — PUBLIC environment variables only.
# Copy to .env.local for local development. Never commit a filled-in file.
# Server-only secrets live in Cloudflare Pages > Settings > Environment
# Variables (encrypted) and are read inside functions/ via context.env.
# See ../SECURITY.md for the full matrix.
# ---------------------------------------------------------------------------

# Site identity
VITE_SITE_URL=https://www.bsdc.info.bd
VITE_SITE_NAME=Bangladesh Software Development Community

# Firebase project "bsdc-bd" (main site + Android app)
VITE_FB_API_KEY=
# For same-origin redirect auth, see docs/auth-production-runbook.md before changing this host.
VITE_FB_AUTH_DOMAIN=bsdc-bd.firebaseapp.com
VITE_FB_PROJECT_ID=bsdc-bd
VITE_FB_STORAGE_BUCKET=bsdc-bd.firebasestorage.app
VITE_FB_MSG_SENDER_ID=
VITE_FB_APP_ID=
VITE_FB_DATABASE_URL=https://bsdc-bd-default-rtdb.asia-southeast1.firebasedatabase.app

# Supabase (primary SQL database)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# FCM web push (public VAPID key). Unused by the site's own push: it only signs
# for Firebase's service. Kept because a deployment may already hold one.
VITE_FIREBASE_VAPID_PUBLIC_KEY=

# Web push, this site's own VAPID key (public half — it ships in the bundle and
# is handed to every browser that subscribes). `npm run push:keys` generates the
# keypair and the flush secret, and prints where every string goes.
VITE_PUSH_VAPID_PUBLIC_KEY=

# OneSignal (manual admin broadcasts only)
VITE_ONESIGNAL_APP_ID=

# Cloudinary (important images, chat PDFs, voice notes)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UNSIGNED_PRESET=

# imgbb (all other user images)
VITE_IMGBB_API_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets — set these in Cloudflare Pages, never in this file.
# Used by functions/api/auth/claims.ts to mint custom claims.
#   FB_CLIENT_EMAIL     service account address for project bsdc-bd
#   FB_PRIVATE_KEY      service account PEM private key
#   FB_PROJECT_ID       bsdc-bd
#   BSDC_OWNER_UIDS     comma separated uid allowlist allowed to set roles
#
# Used by functions/api/push/flush.ts to deliver web push. All four come from
# `npm run push:keys`; the flush secret is also stored in bsdc.push_settings,
# because the database checks it and no function here is given the service key.
#   PUSH_VAPID_PUBLIC_KEY   the uncompressed P-256 point, base64url
#   PUSH_VAPID_PRIVATE_KEY  the PKCS#8 private key, base64url
#   PUSH_FLUSH_SECRET       the bearer token a scheduler presents
#   PUSH_VAPID_SUBJECT      optional contact address, defaults to admin@bsdc.info.bd
#
# See docs/push-runbook.md for the whole path, including the cron worker.
# ---------------------------------------------------------------------------
