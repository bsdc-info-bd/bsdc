{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "typing": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null && (!root.child('chats/' + $chatId + '/metadata/participantIds').exists() || root.child('chats/' + $chatId + '/metadata/participantIds').child(auth.uid).exists())",
          ".write": "auth != null && auth.uid == $uid && (!root.child('chats/' + $chatId + '/metadata/participantIds').exists() || root.child('chats/' + $chatId + '/metadata/participantIds').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['isTyping', 'displayName', 'updatedAt'])"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (!root.child('chats/' + $chatId + '/metadata/participantIds').exists() || root.child('chats/' + $chatId + '/metadata/participantIds').child(auth.uid).exists())",
        "metadata": {
          ".write": "auth != null && (!root.child('chats/' + $chatId + '/metadata/participantIds').exists() || root.child('chats/' + $chatId + '/metadata/participantIds').child(auth.uid).exists() || root.child('chats/' + $chatId + '/metadata/createdBy').val() == auth.uid)"
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null && (root.child('chats/' + $chatId + '/metadata/participantIds').child(auth.uid).exists() || root.child('chats/' + $chatId + '/metadata/createdBy').val() == auth.uid)",
            ".validate": "newData.hasChildren(['senderId', 'createdAt']) && newData.child('senderId').val() == auth.uid"
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid == $uid || !root.child('userChats/' + $uid + '/' + $chatId).exists() || root.child('chats/' + $chatId + '/metadata/participantIds').child(auth.uid).exists())"
        }
      }
    }
  }
}
