# BSDC — .env.example
# Purpose : Ready-to-import environment for local development and Cloudflare Pages builds.
# Owner   : RRC Development / BSDC Platform Team
# Rule    :
#   - Every VITE_* value is bundled into the browser. Public by design. Never put a secret there.
#   - CLOUDINARY_API_SECRET and ONESIGNAL_REST_API_KEY are SERVER ONLY (Firebase Functions /
#     Cloudflare secrets). They must never start with VITE_ and must never reach the client.
#   - Copy this file to `.env` for local work. In Cloudflare Pages, add the same names under
#     Settings → Environment variables (Production + Preview). Mark server secrets as encrypted.
#   - OneSignal is MANUAL BROADCAST ONLY (LAW-09). Firebase / FCM / PWA / native push handle
#     everything automatic. Nothing in the product sends a OneSignal message by itself.
#   - Images only. No video upload path exists. Cloudinary = durable/important. ImgBB = bulk.
# Docs    : docs/18-env-matrix.md (if present)  |  Verification: `npm run verify:env`
# Licence : Source-available. Re-deployment or rebranding is not permitted.

# ---------------------------------------------------------------------------
# APP (public)
# ---------------------------------------------------------------------------
VITE_APP_NAME=BSDC
VITE_APP_URL=https://www.bsdc.info.bd
VITE_APP_PREVIEW_URL=https://bsdc.pages.dev
VITE_APP_DEFAULT_LOCALE=bn
VITE_APP_SUPPORTED_LOCALES=bn,en
VITE_APP_LAUNCH_DATE=2026-01-01T00:00:00+06:00
VITE_APP_ENV=production

# ---------------------------------------------------------------------------
# FIREBASE WEB (public — authority is rules + claims, not these strings)
# Project : bsdc-bd
# Used by : client SDK, messaging SW (via tools/generate-messaging-config.mjs), PWA push
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyBNXVLt5eVghQAFySnGEKy6P8H407hwA1E
VITE_FIREBASE_AUTH_DOMAIN=bsdc-bd.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bsdc-bd
VITE_FIREBASE_STORAGE_BUCKET=bsdc-bd.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1041487418449
VITE_FIREBASE_APP_ID=1:1041487418449:web:350786ca8caf66266a9470
VITE_FIREBASE_DATABASE_URL=https://bsdc-bd-default-rtdb.asia-southeast1.firebasedatabase.app
# Optional Analytics measurement id (Firebase Console → Project settings → Integration).
VITE_FIREBASE_MEASUREMENT_ID=
# Web Push certificates → Key pair (Firebase Console → Project settings → Cloud Messaging).
# Required for FCM / PWA / native automatic push. Leave empty only until the pair is created.
VITE_FIREBASE_VAPID_KEY=
# App Check reCAPTCHA v3 site key when App Check is enforced.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# ---------------------------------------------------------------------------
# MEDIA — Cloudinary (durable / important: avatars, covers, products, ads, PDFs)
# Upload  : unsigned preset only from the browser. API secret stays on the server.
# ---------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=dpemuwrpz
VITE_CLOUDINARY_API_KEY=916675189371449
VITE_CLOUDINARY_UNSIGNED_PRESET=bsdc_unsigned

# ---------------------------------------------------------------------------
# MEDIA — ImgBB (bulk / non-critical: feed, chat, stories)
# Upload  : POST https://api.imgbb.com/1/upload?key=${VITE_IMGBB_API_KEY}
#           body = FormData with base64 field "image" (see src/services/media/imgbb.ts)
# Policy  : images only — no video upload path exists anywhere in the product.
# ---------------------------------------------------------------------------
VITE_IMGBB_API_KEY=fdbfbcfd3bc5189e50a50c574515298d

# ---------------------------------------------------------------------------
# ONESIGNAL — MANUAL BROADCAST DESK ONLY (LAW-09)
# App id  : public, used by the admin broadcast composer to know the desk is configured.
# REST key: SERVER ONLY. Used by the Cloud Function that sends after an admin confirms.
# Worker  : public/OneSignalSDKWorker.js (static asset; not a Cloudflare Worker).
# Never   : schedulers, triggers, re-engagement jobs, or any automatic send path.
# Automatic member push = Firebase Cloud Messaging + PWA + Capacitor native.
# ---------------------------------------------------------------------------
VITE_ONESIGNAL_APP_ID=5f367dc9-3fc3-4fd9-b452-e32fa438509b

# ---------------------------------------------------------------------------
# MAPS / FORMS / OBSERVABILITY (public or optional)
# ---------------------------------------------------------------------------
VITE_GOOGLE_MAPS_DEEP_LINK=true
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=(c) OpenStreetMap contributors
VITE_FORMSUBMIT_ORDERS_ENDPOINT=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_SENTRY_DSN=
VITE_ANALYTICS_ENABLED=false
VITE_ENABLE_INDEXNOW=true
VITE_INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# BUILD / CI SWITCHES (not bundled as product config; used by scripts)
# Set BSDC_REQUIRE_REMOTE_ENV=true on the Cloudflare production build so a
# missing Firebase public config fails the release instead of shipping device-local mode.
# ---------------------------------------------------------------------------
BSDC_REQUIRE_REMOTE_ENV=true

# ---------------------------------------------------------------------------
# SECRET — server / CI / Firebase Functions ONLY
# Never prefix these with VITE_. Never commit real values to a public branch.
# In Cloudflare Pages: Settings → Environment variables → Encrypt.
# In Firebase Functions: functions/.env or Secret Manager / functions:config.
# Paste the real values into your private `.env` (gitignored) or the CF dashboard.
# ---------------------------------------------------------------------------
CLOUDINARY_API_SECRET=
ONESIGNAL_REST_API_KEY=
ADMIN_ROOT_EMAIL=rrc@bsdc.info.bd
ADMIN_ROOT_PASSKEY_HASH=
ADMIN_PASSKEY_PEPPER=
ADS_ACCESS_PEPPER=
PLUGIN_PASSKEY=
VENDOR_REVIEW_PASSKEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_PRIVATE_KEY=
FIRESTORE_EMULATOR_HOST=
GITHUB_TOKEN=
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=
BING_WEBMASTER_API_KEY=
FORM_SUBMIT_SECRET=
REPORT_SIGNING_KEY=
LICENSE_SIGNING_KEY=
BKASH_MERCHANT_PERSONAL_NUMBER=
BKASH_APP_SECRET=
