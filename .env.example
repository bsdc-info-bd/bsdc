# BSDC Environment Configuration
# Copy this file to .env.local and fill in your values

# Site Configuration
VITE_PUBLIC_SITE_URL=https://bsdc.pages.dev

# Firebase Configuration (public client config — safe to expose)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Cloudinary (unsigned upload preset — safe to expose)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ImgBB (public API key for non-critical uploads)
VITE_IMGBB_API_KEY=

# OneSignal (App ID is public)
VITE_ONESIGNAL_APP_ID=

# Feature Flags
VITE_ENABLE_MARKETPLACE=true
VITE_ENABLE_JOBS=true
VITE_ENABLE_MESSAGING=true
VITE_ENABLE_CREATOR_PROGRAM=true
VITE_ENABLE_ADS=true
VITE_ENABLE_GROUPS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_LICENSES=true

# NEVER put these in .env files with VITE_ prefix:
# - Cloudinary API Secret
# - OneSignal REST API Key
# - Firebase Admin Private Key
# - OAuth Client Secrets
