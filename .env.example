# BSDC — .env.example
# Purpose : Single source of truth for every environment variable the platform understands.
# Owner   : RRC Development / BSDC Platform Team
# Rule    : This file contains NAMES and DOCUMENTATION only — never a real value.
#           Every VITE_* variable is bundled and therefore PUBLIC by design.
#           Anything secret must never start with VITE_ and must never reach the browser.
# Docs    : docs/18-env-matrix.md  |  Verification: `npm run verify:env`
# Licence : Source-available. Re-deployment or rebranding is not permitted.

# ---------------------------------------------------------------------------
# PUBLIC (safe in bundle)
# ---------------------------------------------------------------------------
VITE_APP_NAME=BSDC
VITE_APP_URL=https://www.bsdc.info.bd
VITE_APP_PREVIEW_URL=https://bsdc.pages.dev
VITE_APP_DEFAULT_LOCALE=bn
VITE_APP_SUPPORTED_LOCALES=bn,en
VITE_APP_LAUNCH_DATE=2026-01-01T00:00:00+06:00
