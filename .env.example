# =============================================================================
# BSDC environment template — copy to `.env` and fill in.
# `.env` is gitignored and must never be committed.
#
# Only VITE_-prefixed variables are exposed to the client bundle.
# SERVER-ONLY SECRETS (Cloudinary API secret, OneSignal REST API key, ImgBB
# key, SMTP credentials) must NEVER be given a VITE_ prefix and must NEVER be
# committed. They live only in Firebase Cloud Function environment config.
# =============================================================================

# --- Firebase web client config ---------------------------------------------
# Safe for the client bundle BY DESIGN, provided Firestore/Storage security
# rules and Firebase App Check are enforced. See docs/SECURITY.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# --- Cloudinary (client-safe subset only) ------------------------------------
# Cloud name + unsigned upload preset only. API key/secret are server-side.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- OneSignal (client-safe subset only) -------------------------------------
# Web-push App ID only. The REST API key is a Cloud Function secret.
VITE_ONESIGNAL_APP_ID=
