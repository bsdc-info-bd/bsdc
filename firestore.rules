rules_version = '2';
// BSDC — Bangladesh Software Development Community. Copyright (c) RRC Development. Proprietary — see LICENSE.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function userRole() {
      return signedIn()
        ? (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role || 'user')
        : 'guest';
    }
    function isSuperadmin() { return userRole() == 'superadmin'; }
    function isAdmin() { return userRole() in ['superadmin', 'admin']; }
    function isStaff() { return userRole() in ['superadmin', 'admin', 'manager', 'moderator']; }
    function notBanned() { return userRole() != 'banned'; }
    function isPostOwner(authorId) { return signedIn() && request.auth.uid == authorId; }

    // ------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid) || isSuperadmin();
      // Role, points and verification fields are server-managed; superadmin bootstraps own role.
      allow update: if (isSelf(uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['displayName','username','avatar','coverPhoto','bio','bioTitle','location',
                                       'website','github','linkedin','twitter','skills','education','work','language',
                                       'theme','lastActive','isOnline','emailVerified','profileCompleted','onboardingStep',
                                       'postCount','followerCount','followingCount','bsdcPoints','streak','lastLoginDay',
                                       'creatorProgramStatus','softwareLicenses','isCreator','updatedAt','role','isVerified']))
                    || (isSuperadmin() && request.resource.data.role == 'superadmin')
                    || isAdmin()
                    || (isStaff() && request.resource.data.diff(resource.data).affectedKeys()
                                      .hasOnly(['role','isVerified','isCreator','creatorProgramStatus','updatedAt']));
      allow delete: if isSuperadmin();

      match /notifications/{doc} { allow read, write: if false; }
    }

    match /notifications/{uid}/items/{notifId} {
      allow read: if isSelf(uid);
      allow create: if signedIn() && notBanned();
      allow update: if isSelf(uid);
      allow delete: if isSelf(uid) || isStaff();
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.authorId == request.auth.uid;
      allow update: if (isPostOwner(resource.data.authorId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['title','body','images','tags','visibility','status','scheduledAt','seoTitle',
                                       'seoDescription','canonicalUrl','snippet','poll','edited','updatedAt','wikiRevisions',
                                       'reactionCounts','reactionTotal','commentCount','viewCount','shareCount','bookmarkCount',
                                       'pinned','featured']))
                    || isStaff();
      allow delete: if isPostOwner(resource.data.authorId) || isStaff();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.authorId == request.auth.uid;
      allow update: if isPostOwner(resource.data.authorId)
                    || isStaff()
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['reactionCounts','reactionTotal','accepted','deleted','body','edited','updatedAt']);
      allow delete: if isPostOwner(resource.data.authorId) || isStaff();
    }

    match /reactions/{reactionId} {
      allow read: if true;
      allow create, update: if signedIn() && notBanned() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create, delete: if signedIn() && notBanned() && request.resource.data.followerId == request.auth.uid;
    }

    match /bookmarks/{bookmarkId} {
      allow read: if true;
      allow write: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /tags/{tag} {
      allow read: if true;
      allow write: if signedIn() && notBanned();
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.authorId == request.auth.uid;
      allow update: if isPostOwner(resource.data.authorId) || signedIn(); // view increments
      allow delete: if isPostOwner(resource.data.authorId) || isStaff();
    }

    match /polls/{voteId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.voterUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------ groups
    match /groups/{groupId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && notBanned() || isStaff();
      allow delete: if isStaff();
    }

    match /groupMembers/{memberId} {
      allow read: if true;
      allow write: if signedIn() && notBanned();
    }

    // ------------------------------------------------------ infrastructure
    match /pointTransactions/{txId} {
      allow read: if true;
      allow create: if signedIn() && notBanned();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isStaff() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if signedIn() && notBanned() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isStaff();
    }

    match /licenses/{licenseId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /creatorApplications/{uid} {
      allow read: if isStaff() || isSelf(uid);
      allow create: if isSelf(uid);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /marketplace/{listingId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.sellerId == request.auth.uid;
      allow update: if signedIn() || isStaff();
      allow delete: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.hostId == request.auth.uid;
      allow update: if signedIn() && notBanned() || isStaff();
      allow delete: if isStaff();
    }

    match /modLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /searchLog/{docId} {
      allow read: if isStaff();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /contactMessages/{docId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics/{doc}/{sub} {
      allow read: if isAdmin();
      allow write: if isStaff();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
