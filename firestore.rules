rules_version = '2';
// BSDC — Bangladesh Software Development Community. Copyright (c) RRC Development. Proprietary — see LICENSE.
//
// Role hierarchy: superadmin > admin > manager > moderator > verified > user > restricted > banned.
// Design principles:
//   1. Owner-scoped writes for content (author fields match auth.uid).
//   2. Counter-field writes (views, reactions, comment counts, RSVPs, member counts)
//      are open to signed-in non-banned users but restricted to those exact fields.
//   3. Role/verification changes require staff, or the founder email bootstrap.
//   4. Everything not matched explicitly is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function notBanned() { return userRole() != 'banned'; }
    function userRole() {
      return signedIn()
        ? (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role || 'user')
        : 'guest';
    }
    function isSuperadmin() { return userRole() == 'superadmin'; }
    function isAdmin() { return userRole() in ['superadmin', 'admin']; }
    function isStaff() { return userRole() in ['superadmin', 'admin', 'manager', 'moderator']; }
    function founderEmail(uid) {
      return isSelf(uid)
        && resource.data.email == 'rahimchawdhury63@gmail.com'
        && request.resource.data.role in ['superadmin', 'admin'];
    }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isCreate() { return resource == null; }

    // Counter fields a normal signed-in user may bump on any post.
    function postCounterWrite() {
      return signedIn() && notBanned()
        && changedKeys().hasOnly(['viewCount', 'shareCount', 'bookmarkCount', 'commentCount',
                                  'reactionCounts', 'reactionTotal', 'poll', 'updatedAt']);
    }
    function commentCounterWrite() {
      return signedIn() && notBanned()
        && changedKeys().hasOnly(['reactionCounts', 'reactionTotal', 'replyCount', 'accepted', 'updatedAt']);
    }

    // -------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid);
      allow update: if (
                          // Profile self-service — privilege fields are NOT in this list.
                          (isSelf(uid)
                            && changedKeys().hasOnly(['displayName','username','avatar','coverPhoto','bio',
                              'bioTitle','location','geo','website','github','linkedin','twitter','skills',
                              'education','work','language','theme','lastActive','isOnline','emailVerified',
                              'profileCompleted','onboardingStep','pushTokens','postCount','followerCount','followingCount',
                              'bsdcPoints','streak','lastLoginDay','creatorProgramStatus','softwareLicenses',
                              'isCreator','updatedAt']))
                          // Founder bootstrap: the configured email may elevate itself to superadmin/admin.
                          || founderEmail(uid)
                          // Full admin control.
                          || isAdmin()
                          // Moderators may only manage non-privileged roles.
                          || (isStaff()
                              && (!('role' in changedKeys())
                                  || request.resource.data.role in ['moderator','verified','user','restricted','banned'])
                              && changedKeys().hasOnly(['role','isVerified','isCreator','creatorProgramStatus',
                                  'displayName','username','avatar','bio','bioTitle','location','geo','updatedAt']))
                          // Follow graph: the follower may bump the target's followerCount.
                          || (signedIn() && notBanned()
                              && changedKeys().hasOnly(['followerCount', 'updatedAt']))
                          // Points transfers: sender may move balances (logged in /pointTransactions).
                          || (signedIn() && notBanned()
                              && changedKeys().hasOnly(['bsdcPoints', 'updatedAt']))
                        );
      allow delete: if isSuperadmin();

      // Notifications live in /notifications — block stray writes under user docs.
      match /{sub=**} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    match /notifications/{uid}/items/{notifId} {
      allow read: if isSelf(uid) || isStaff();
      // The actor must be the writer — prevents spoofing notifications as someone else.
      allow create: if signedIn() && notBanned() && request.resource.data.actorId == request.auth.uid;
      allow update: if isSelf(uid) && changedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if isSelf(uid) || isStaff();
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && isCreate() && request.resource.data.uid == request.auth.uid;
      // Claim a free name or move your own reservation; releases use update with released=true.
      allow update: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && (resource.data.uid == request.auth.uid || resource.data.uid == '');
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------- posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && notBanned()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status in ['draft', 'published', 'scheduled'];
      allow update: if (
                        (request.auth.uid == resource.data.authorId
                          && changedKeys().hasOnly(['title','body','images','tags','visibility','status',
                            'scheduledAt','seoTitle','seoDescription','canonicalUrl','snippet','poll','job',
                            'project','notice','edited','updatedAt','wikiRevisions','pinned',
                            'reactionCounts','reactionTotal','commentCount','viewCount','shareCount',
                            'bookmarkCount','publishedAt']))
                        || postCounterWrite()
                        || isStaff()
                      );
      allow delete: if request.auth.uid == resource.data.authorId || isStaff();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.authorId == request.auth.uid;
      allow update: if (
                        (request.auth.uid == resource.data.authorId
                          && changedKeys().hasOnly(['body','imageUrl','edited','deleted',
                            'reactionCounts','reactionTotal','updatedAt']))
                        || commentCounterWrite()
                        || isStaff()
                      );
      allow delete: if request.auth.uid == resource.data.authorId || isStaff();
    }

    match /reactions/{reactionId} {
      allow read: if true;
      allow create, update: if signedIn() && notBanned()
                            && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create, delete: if signedIn() && notBanned()
                            && request.resource.data.followerId == request.auth.uid;
    }

    match /bookmarks/{bookmarkId} {
      allow read: if true;
      allow write: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /tags/{tagName} {
      allow read: if true;
      // Anyone signed in may maintain tag counters (postCount only).
      allow create: if signedIn() && notBanned();
      allow update: if signedIn() && notBanned()
                    && changedKeys().hasOnly(['postCount', 'name', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.authorId == request.auth.uid;
      // Owners edit freely; others may only record a view.
      allow update: if (request.auth.uid == resource.data.authorId)
                    || (signedIn() && notBanned()
                        && changedKeys().hasOnly(['viewCount', 'viewers', 'updatedAt']));
      allow delete: if request.auth.uid == resource.data.authorId || isStaff();
    }

    match /polls/{voteId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.voterUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- groups
    match /groups/{groupId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.createdBy == request.auth.uid;
      allow update: if (
                      request.auth.uid == resource.data.createdBy
                      || isStaff()
                      // Members may only bump memberCount when joining/leaving.
                      || (signedIn() && notBanned() && changedKeys().hasOnly(['memberCount', 'updatedAt']))
                    );
      allow delete: if isStaff();
    }

    match /groupMembers/{memberId} {
      allow read: if true;
      // Join freely (public), or leave yourself.
      allow create: if signedIn() && notBanned() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff()
                    || (signedIn() && changedKeys().hasOnly(['role', 'joinedAt', 'updatedAt']));
      allow delete: if signedIn() && resource.data.userId == request.auth.uid || isStaff();
    }

    // ------------------------------------------------------ infrastructure
    match /pointTransactions/{txId} {
      allow read: if true;
      // Sender is always the writer; balances are guarded in users.update + client transactions.
      allow create: if signedIn() && notBanned() && request.resource.data.from == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isStaff() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if signedIn() && notBanned() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isStaff();
    }

    match /licenses/{licenseId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /creatorApplications/{uid} {
      allow read: if isStaff() || isSelf(uid);
      allow create: if isSelf(uid);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /marketplace/{listingId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.sellerId == request.auth.uid;
      allow update: if (
                      request.auth.uid == resource.data.sellerId
                      || isStaff()
                      // Saved-listing bookkeeping by any signed-in user.
                      || (signedIn() && notBanned() && changedKeys().hasOnly(['savedBy', 'savedCount', 'updatedAt']))
                    );
      allow delete: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      // Advertisers manage their own campaigns; metrics counters open to signed-in users.
      allow create: if signedIn() && notBanned() && request.resource.data.advertiserId == request.auth.uid;
      allow update: if (
                      request.auth.uid == resource.data.advertiserId
                      || isAdmin()
                      || (signedIn() && notBanned()
                          && changedKeys().hasOnly(['impressions','clicks','conversions','ctr','updatedAt']))
                    );
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn() && notBanned() && request.resource.data.hostId == request.auth.uid;
      allow update: if (
                      request.auth.uid == resource.data.hostId
                      || isStaff()
                      // RSVP bookkeeping by any signed-in user.
                      || (signedIn() && notBanned()
                          && changedKeys().hasOnly(['rsvps','goingCount','interestedCount','updatedAt']))
                    );
      allow delete: if isStaff();
    }

    match /modLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /searchLog/{docId} {
      allow read: if isStaff();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /contactMessages/{docId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /systemConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics/{document}/{sub} {
      allow read: if isAdmin();
      allow write: if isStaff();
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
