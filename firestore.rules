rules_version = '2';

// ============================================================
// BSDC — Firestore Security Rules
// ============================================================
//
// These rules enforce:
// - Authentication requirements
// - Role-based access control (RBAC)
// - Data ownership validation
// - Field-level validation
// - Rate limiting considerations
// - Sensitive field protection
//
// IMPORTANT: Deploy these rules to your Firebase project using:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function hasRole(role) {
      let hierarchy = ['OWNER', 'SUPER_ADMIN', 'ADMIN', 'MANAGEMENT', 'MANAGER', 'MODERATOR', 'EDITOR', 'SUPPORT', 'VERIFIED_CREATOR', 'VERIFIED_ORGANIZATION', 'USER'];
      return isAuthenticated() &&
        hierarchy.indexOf(getUserRole()) <= hierarchy.indexOf(role);
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isModerator() {
      return hasRole('MODERATOR');
    }

    function isManager() {
      return hasRole('MANAGER');
    }

    function hasPermission(permission) {
      return isAuthenticated() && (
        getUserRole() == 'OWNER' ||
        getUserRole() == 'SUPER_ADMIN' ||
        permission in getUserData().permissions
      );
    }

    function isBanned() {
      return isAuthenticated() && getUserData().isBanned == true;
    }

    function isSuspended() {
      return isAuthenticated() &&
        getUserData().isSuspended == true &&
        (getUserData().suspendedUntil == null || getUserData().suspendedUntil > request.time.toMillis());
    }

    function canWrite() {
      return isAuthenticated() && !isBanned() && !isSuspended();
    }

    function isValidString(value, minLen, maxLen) {
      return value is string && size(value) >= minLen && size(value) <= maxLen;
    }

    function isValidTimestamp(value) {
      return value is number && value > 0;
    }

    function serverTimestamp() {
      return request.time.toMillis();
    }

    // ============================================================
    // USERS Collection
    // ============================================================
    match /users/{userId} {
      // Users can read their own data; admins can read any
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile during registration
      allow create: if isOwner(userId)
        && request.resource.data.role == 'USER'
        && request.resource.data.isBanned == false
        && request.resource.data.isSuspended == false;

      // Users can update limited fields of their own profile
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.isBanned == resource.data.isBanned
        && request.resource.data.isSuspended == resource.data.isSuspended
        && request.resource.data.suspendedUntil == resource.data.suspendedUntil;

      // Only OWNER/SUPER_ADMIN can delete users
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // ============================================================
    // USER PROFILES Collection
    // ============================================================
    match /userProfiles/{userId} {
      allow read: if true; // Public profiles are readable

      allow create: if isOwner(userId)
        && isValidString(request.resource.data.username, 3, 30)
        && isValidString(request.resource.data.displayName, 1, 100);

      allow update: if isOwner(userId)
        && request.resource.data.username == resource.data.username
        && request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.isCreator == resource.data.isCreator
        && request.resource.data.reputation == resource.data.reputation
        && request.resource.data.followersCount == resource.data.followersCount
        && request.resource.data.followingCount == resource.data.followingCount
        && request.resource.data.postsCount == resource.data.postsCount;

      allow delete: if isOwner(userId) || isAdmin();
    }

    // ============================================================
    // POSTS Collection
    // ============================================================
    match /posts/{postId} {
      allow read: if resource.data.visibility == 'public'
        || (isAuthenticated() && resource.data.visibility == 'followers')
        || isOwner(resource.data.authorId)
        || isModerator();

      allow create: if canWrite()
        && request.resource.data.authorId == request.auth.uid
        && isValidString(request.resource.data.title, 1, 200)
        && request.resource.data.status in ['draft', 'published', 'scheduled']
        && request.resource.data.reactionsCount is map
        && request.resource.data.commentsCount == 0
        && request.resource.data.sharesCount == 0
        && request.resource.data.bookmarksCount == 0
        && request.resource.data.viewsCount == 0
        && request.resource.data.isPinned == false
        && request.resource.data.isFeatured == false;

      allow update: if (isOwner(resource.data.authorId) && request.resource.data.authorId == resource.data.authorId)
        || isModerator();

      allow delete: if isOwner(resource.data.authorId) || isModerator();
    }

    // ============================================================
    // COMMENTS Collection
    // ============================================================
    match /comments/{commentId} {
      allow read: if true;

      allow create: if canWrite()
        && request.resource.data.authorId == request.auth.uid
        && isValidString(request.resource.data.body, 1, 5000)
        && request.resource.data.depth >= 0
        && request.resource.data.depth <= 5
        && request.resource.data.isDeleted == false
        && request.resource.data.isPinned == false;

      allow update: if (isOwner(resource.data.authorId) && request.resource.data.body != resource.data.body)
        || isModerator();

      allow delete: if isOwner(resource.data.authorId) || isModerator();
    }

    // ============================================================
    // REACTIONS Collection
    // ============================================================
    match /reactions/{reactionId} {
      allow read: if true;

      allow create: if canWrite()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reactionType in ['like', 'love', 'care', 'haha', 'wow', 'sad', 'angry', 'fire', 'mind_blown'];

      allow delete: if isOwner(resource.data.userId) || isModerator();
    }

    // ============================================================
    // FOLLOWS Collection
    // ============================================================
    match /follows/{followId} {
      allow read: if true;
      allow create: if canWrite()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isOwner(resource.data.followerId);
    }

    // ============================================================
    // BLOCKS & MUTES
    // ============================================================
    match /blocks/{blockId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if canWrite() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
    }

    match /mutes/{muteId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if canWrite() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
    }

    // ============================================================
    // BOOKMARKS
    // ============================================================
    match /bookmarks/{bookmarkId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if canWrite() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated(); // System or other users can create notifications
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isOwner(resource.data.userId);
    }

    // ============================================================
    // CONVERSATIONS & MESSAGES
    // ============================================================
    match /conversations/{conversationId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participants;

      allow create: if canWrite();

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if canWrite()
          && request.resource.data.senderId == request.auth.uid
          && isValidString(request.resource.data.body, 0, 10000);
        allow update: if isOwner(resource.data.senderId);
        allow delete: if isOwner(resource.data.senderId) || isModerator();
      }
    }

    // ============================================================
    // GROUPS
    // ============================================================
    match /groups/{groupId} {
      allow read: if resource.data.privacy == 'public'
        || (isAuthenticated() && request.auth.uid in resource.data.memberIds)
        || isModerator();

      allow create: if canWrite()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isOwner(resource.data.createdBy) || isModerator();
      allow delete: if isOwner(resource.data.createdBy) || isAdmin();
    }

    // ============================================================
    // REPORTS
    // ============================================================
    match /reports/{reportId} {
      allow read: if isModerator() || isOwner(resource.data.reporterId);
      allow create: if canWrite()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isModerator();
      allow delete: if isAdmin();
    }

    // ============================================================
    // ADMIN-ONLY Collections
    // ============================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /featureFlags/{flagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if isAdmin() || isOwner(resource.data.advertiserId);
      allow create: if canWrite() && hasPermission('ads:create');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /licenses/{licenseId} {
      allow read: if resource.data.isPublic == true || isAdmin() || isOwner(resource.data.developerId);
      allow create: if canWrite() && hasPermission('license:register');
      allow update: if isAdmin() || isOwner(resource.data.developerId);
      allow delete: if isAdmin();
    }

    match /creatorApplications/{applicationId} {
      allow read: if isOwner(resource.data.userId) || isManager();
      allow create: if canWrite() && request.resource.data.userId == request.auth.uid;
      allow update: if isManager();
    }

    // ============================================================
    // PUBLIC READ Collections
    // ============================================================
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow create: if canWrite();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.teamMembers || isModerator();
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if canWrite() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId) || isModerator();
      allow delete: if isOwner(resource.data.authorId) || isModerator();
    }

    match /jobs/{jobId} {
      allow read: if resource.data.status == 'approved' || isAdmin() || isOwner(resource.data.companyId);
      allow create: if canWrite() && hasPermission('jobs:post');
      allow update: if isOwner(resource.data.companyId) || isModerator();
      allow delete: if isOwner(resource.data.companyId) || isModerator();
    }

    match /marketplaceListings/{listingId} {
      allow read: if resource.data.status == 'active' || isAdmin() || isOwner(resource.data.sellerId);
      allow create: if canWrite() && hasPermission('marketplace:sell');
      allow update: if isOwner(resource.data.sellerId) || isModerator();
      allow delete: if isOwner(resource.data.sellerId) || isModerator();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if canWrite() && hasPermission('events:create');
      allow update: if isOwner(resource.data.organizerId) || isModerator();
      allow delete: if isOwner(resource.data.organizerId) || isModerator();
    }

    // ============================================================
    // Catch-all: deny by default
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
