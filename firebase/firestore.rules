rules_version = '2';

// ---------------------------------------------------------------------------
// BSDC Firestore rules — project bsdc-bd.
//
// Firestore is intentionally a small, fast cache next to Supabase: profile
// documents, the username index and ephemeral device records. Nothing here is
// writable without an authenticated, verified session, and no document may be
// written on behalf of another member.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return signedIn() && request.auth.token.staff == true;
    }

    function usernameShape(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 24
        && value.matches('^[a-z0-9_]+$')
        && !value.matches('^_.*')
        && !value.matches('.*_$');
    }

    function bootstrapProfile(data, uid) {
      return data.keys().hasOnly([
          'uid', 'displayName', 'onboardingComplete', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.onboardingComplete == false
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function completedProfile(data, uid) {
      return data.keys().hasOnly([
          'uid', 'username', 'displayName', 'bio', 'avatarUrl', 'location',
          'website', 'skills', 'interests', 'language', 'onboardingComplete',
          'notifications', 'privacy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'username', 'displayName', 'bio', 'avatarUrl', 'location',
          'website', 'skills', 'interests', 'language', 'onboardingComplete',
          'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && usernameShape(data.username)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 60
        && data.bio is string
        && data.bio.size() <= 280
        && data.avatarUrl is string
        && data.avatarUrl.size() <= 2048
        && data.location is string
        && data.location.size() <= 80
        && data.website is string
        && data.website.size() <= 2048
        && data.skills is list
        && data.skills.size() <= 20
        && data.interests is list
        && data.interests.size() <= 20
        && (data.language == 'bn' || data.language == 'en')
        && data.onboardingComplete is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // users/{uid} — the profile cache mirrored from Supabase. A bare document
    // is created at first sign-in before a member chooses a username; the
    // completed profile transaction then replaces it with the full validated
    // shape. Keeping those states explicit prevents the bootstrap write from
    // being rejected solely because username/bio do not exist yet.
    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid)
        && (bootstrapProfile(request.resource.data, uid)
          || completedProfile(request.resource.data, uid));
      allow update: if isSelf(uid)
        && ((bootstrapProfile(resource.data, uid)
            && completedProfile(request.resource.data, uid))
          || (completedProfile(resource.data, uid)
            && completedProfile(request.resource.data, uid)));
      allow delete: if isStaff();
    }

    // usernames/{username} — uniqueness index, claimed in a transaction.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && usernameShape(username)
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // devices/{uid}/tokens/{tokenId} — push registrations, private per member.
    match /devices/{uid}/tokens/{tokenId} {
      allow read, write: if isSelf(uid);
    }

    // Everything else is denied until the module that owns it ships.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
