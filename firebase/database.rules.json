{
  "rules": {
    ".read": false,
    ".write": false,
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).val() === true",
        ".write": "auth != null && ((!data.exists() && newData.child('participants').child(auth.uid).val() === true && (newData.child('kind').val() === 'direct' || newData.child('kind').val() === 'group')) || (data.child('participants').child(auth.uid).val() === true && newData.child('participants').child(auth.uid).val() === true))",
        ".validate": "(newData.child('kind').val() === 'direct' || newData.child('kind').val() === 'group') && (newData.child('kind').val() !== 'direct' || newData.child('participants').numChildren() === 2) && (newData.child('kind').val() !== 'group' || (newData.child('participants').numChildren() >= 2 && newData.child('participants').numChildren() <= 50))",
        "participants": {
          "$uid": {
            ".validate": "(!data.exists() && newData.val() === true) || (data.exists() && newData.val() === data.val())"
          }
        },
        "title": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)" },
        "description": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
        "memberCount": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 50" },
        "lastMessage": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "lastMessageAt": { ".validate": "newData.isNumber()" }
      },
      ".indexOn": ["lastMessageAt"]
    },
    "messages": {
      "$conversationId": {
        ".read": "auth != null && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true",
        "$messageId": {
          ".write": "auth != null && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true && ((!data.exists() && newData.child('senderId').val() === auth.uid) || (data.child('senderId').val() === auth.uid && newData.child('senderId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['senderId', 'kind', 'sentAt']) && newData.child('kind').val() in ['text', 'image', 'audio'] && (!newData.child('body').exists() || (newData.child('body').isString() && newData.child('body').val().length <= 4000))"
        },
        ".indexOn": ["sentAt"]
      }
    },
    "typing": {
      "$conversationId": {
        "$uid": {
          ".read": "auth != null && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true",
          ".write": "auth != null && auth.uid === $uid && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() === true",
          ".validate": "newData.val() === true || newData.val() === false"
        }
      }
    }
  }
}
