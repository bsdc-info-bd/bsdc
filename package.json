{
  "name": "bsdc",
  "private": true,
  "version": "1.0.0",
  "description": "Bangladesh Software Development Community (BSDC) — The Pride of Bangladesh. Built by RRC Development.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "cap sync",
    "cap:android": "cap add android && cap sync android"
  },
  "dependencies": {
