{
  "name": "bsdc",
  "version": "0.2.0-response2",
  "private": true,
  "description": "BSDC \u2014 Bangladesh Software Development Community. A platform of RRC Development.",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Rizwan Rahim Chowdhury",
    "email": "hello@bsdc.info.bd",
    "url": "https://www.bsdc.info.bd"
  },
  "homepage": "https://www.bsdc.info.bd",
  "repository": {
    "type": "git",
    "url": "https://github.com/bsdc-info-bd/bsdc.git"
  },
  "bugs": {
    "url": "https://github.com/bsdc-info-bd/bsdc/issues",
    "email": "hello@bsdc.info.bd"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "npm run verify:env && npm run icons:sprite && npm run messaging:config && vite build",
    "build:pages": "npm run build && npm run build:sitemap && npm run build:rss",
    "build:sitemap": "echo \"[bsdc] sitemap pipeline lands in RESPONSE 5 (see build/sitemap)\" && exit 0",
    "build:rss": "echo \"[bsdc] rss pipeline lands in RESPONSE 5 (see build/rss)\" && exit 0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:no-emoji": "node tools/lint/no-emoji.mjs",
    "check:placeholders": "bash scripts/check-no-placeholders.sh",
    "check:workers": "bash scripts/check-no-workers.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,css,json,md,html,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,css,json,md,html,yml}\"",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:env": "tsx scripts/verify-env.ts",
    "verify": "npm run format:check && npm run lint && npm run lint:no-emoji && npm run typecheck && npm run check:placeholders && npm run check:workers && npm run check:rules && npm run check:rtdb && npm run test && npm run build",
    "icons:generate": "node tools/generate-sprite.mjs && node tools/generate-icons.mjs",
    "clean": "rimraf dist .vite-temp coverage",
    "analyze": "ANALYZE=true npm run build",
    "docs:tree": "node scripts/generate-repo-tree.mjs",
    "icons:sprite": "node tools/generate-sprite.mjs",
    "messaging:config": "node tools/generate-messaging-config.mjs",
    "verify:functions": "npm --prefix functions run build && npx tsx --test functions/src/*.test.ts",
    "check:rules": "node scripts/check-rules.mjs",
    "check:rtdb": "node scripts/check-rtdb.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-portal": "1.1.17",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "@react-aria/live-announcer": "3.5.1",
    "@tanstack/react-query": "5.103.1",
    "@types/leaflet": "^1.9.20",
    "canvas-confetti": "1.9.4",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dayjs": "1.11.23",
    "firebase": "12.19.0",
    "focus-trap-react": "12.0.3",
    "framer-motion": "12.43.0",
    "i18next": "25.10.10",
    "i18next-http-backend": "4.0.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.577.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "15.7.4",
    "react-router-dom": "7.18.4",
    "react-window": "2.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/canvas-confetti": "1.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "maintained node versions",
    "not dead",
    "not op_mini all",
    "not ie 11",
    "chrome >= 90",
    "firefox >= 90",
    "safari >= 15",
    "edge >= 90",
    "android >= 7",
    "ios_saf >= 15"
  ],
  "keywords": [
    "bsdc",
    "bangladesh",
    "software-development-community",
    "rrc-development",
    "react",
    "vite",
    "typescript",
    "firebase",
    "capacitor"
  ]
}
