{
  "id": "/",
  "name": "BSDC — Bangladesh Software Development Community",
  "short_name": "BSDC",
  "description": "Bangladesh Software Development Community — code, community and commerce on one platform. A platform of RRC Development.",
  "lang": "bn",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b1220",
  "theme_color": "#2d6a4f",
  "categories": ["social", "education", "business", "developer"],
  "prefer_related_applications": true,
  "related_applications": [
    {
      "platform": "play",
      "id": "bd.info.bsdc.app",
      "url": "https://play.google.com/store/apps/details?id=bd.info.bsdc.app"
    }
  ],
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/favicon-16.png", "sizes": "16x16", "type": "image/png", "purpose": "any" },
    { "src": "/icons/favicon-32.png", "sizes": "32x32", "type": "image/png", "purpose": "any" },
    { "src": "/icons/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "/icons/mstile-150.png", "sizes": "150x150", "type": "image/png", "purpose": "any" },
    { "src": "/icons/android-chrome-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/android-chrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Feed", "short_name": "Feed", "url": "/feed" },
    { "name": "Messages", "short_name": "Messages", "url": "/messages" },
    { "name": "Marketplace", "short_name": "Market", "url": "/market" }
  ]
}
